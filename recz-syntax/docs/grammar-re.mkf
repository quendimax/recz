re
    disjunct

disjunct
    concat
    concat '|' disjunct

concat
    ""
    item
    item concat

item
    term
    class
    group
    item postfix

postfix
    '*'
    '+'
    '?'
    '{' decimal '}'
    '{' decimal ',' '}'
    '{' decimal ',' decimal '}'

group
    "(" disjunct ")"                       ; just parentheses
    "(?:" disjunct ")"                     ; non-capturing group (the same as "(" disjunct ")")
    "(?<" capture_name ">" disjunct ")"    ; named capturing group
    "(?D<" decimal ">" disjunct ")"        ; numbered capturing group

class               ; class corresponds to a subset of unicode code points
    '.'
    "[" elements "]"
    "[^" elements "]"

elements
    element
    element elements

element
    term
    term '-' term
    class

term                ; terminals correspond to one unicode code point
    char
    escape

char
    '0000' . '10FFFF' - '\' - '.' - '*' - '+' - '-' - '?' - '^' - '$' - '|' - '(' - ')' - '[' - ']' - '{' - '}'

escape
    ascii_escape
    unicode_escape

ascii_escape
    "\\"
    "\."
    "\*"
    "\+"
    "\-"
    "\?"
    "\^"
    "\$"
    "\|"
    "\("
    "\)"
    "\["
    "\]"
    "\{"
    "\}"
    "\0"
    "\n"
    "\r"
    "\t"
    "\x" oct hex

unicode_escape
    "\u{" hex "}"
    "\u{" hex hex "}"
    "\u{" hex hex hex "}"
    "\u{" hex hex hex hex "}"
    "\u{" hex hex hex hex hex "}"
    "\u{" hex hex hex hex hex hex "}"

capture_name
    name_first_char
    capture_name name_char

name_first_char
    '_'
    'a' . 'z'
    'A' . 'Z'

name_char
    name_first_char
    '.'
    '-'
    '['
    ']'
    '0' . '9'

decimal
    dec
    dec decimal

oct
    '0' . '7'

dec
    '0' . '9'

hex
    '0' . '9'
    'a' . 'f'
    'A' . 'F'
